{
  "name": "ledger-windows-app",
  "version": "1.0.1",
  "description": "Secure Local Ledger Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ledger.app",
    "productName": "Ledger",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "g00d001028-beep",
        "repo": "Ledger"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}